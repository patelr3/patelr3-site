server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # API proxy: auth (public)
    location /api/auth/ {
        proxy_pass ${AUTH_API_UPSTREAM}/auth/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Internal auth verification (used by auth_request)
    location = /_auth_verify {
        internal;
        proxy_pass ${AUTH_API_UPSTREAM}/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Cookie $http_cookie;
    }

    # API proxy: hello-world (protected)
    location /api/hello/ {
        auth_request /_auth_verify;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        auth_request_set $auth_role $upstream_http_x_auth_role;
        proxy_set_header X-Auth-User $auth_user;
        proxy_set_header X-Auth-Role $auth_role;

        proxy_pass ${HELLO_API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # API proxy: hello-world-restricted (protected)
    location /api/hello-restricted/ {
        auth_request /_auth_verify;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        auth_request_set $auth_role $upstream_http_x_auth_role;
        proxy_set_header X-Auth-User $auth_user;
        proxy_set_header X-Auth-Role $auth_role;

        proxy_pass ${HELLO_RESTRICTED_API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: serve index.html for all other routes
    location / {
        try_files $uri $uri/ /index.html;
    }
}
