# Firebase project ID (from https://console.firebase.google.com)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Google OAuth credentials — only used by OIDC IdP for ActualBudget (deferred migration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT signing key (generate with: openssl rand -hex 32) — used for OIDC backward compat
JWT_SECRET=change-me-to-a-random-secret

# PostgreSQL
POSTGRES_USER=patelr3
POSTGRES_PASSWORD=change-me
POSTGRES_DB=patelr3_site

# Frontend public URL (used for OAuth redirects)
FRONTEND_URL=http://localhost

# Azure Application Insights (optional for local, required in production)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Foundry (SunnieAI chat) — optional for local dev
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=sunnieai

# OIDC JWKS URL for MCP server (defaults to local auth-api in docker-compose)
OIDC_JWKS_URL=
