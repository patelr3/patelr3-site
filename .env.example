# Google OAuth 2.0 credentials (from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT signing key (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret

# PostgreSQL
POSTGRES_USER=patelr3
POSTGRES_PASSWORD=change-me
POSTGRES_DB=patelr3_site

# Frontend public URL (used for OAuth redirects)
FRONTEND_URL=http://localhost
