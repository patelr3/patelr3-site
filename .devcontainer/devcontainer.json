{
  "name": "patelr3-site",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [80, 3000, 5000, 5432, 8000],
  "postCreateCommand": "cd /workspaces/patelr3-site/frontend && npm install",
  "customizations": {
    "codespaces": {
      "repositories": {
        "patelr3/actual-server-setup": {
          "permissions": {
            "contents": "write",
            "workflows": "write"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true
      }
    }
  }
}
